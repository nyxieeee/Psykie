# Single application environment file. Keep actual values in .env.local.

# SUPABASE - public frontend configuration
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon key; leave blank when using the publishable key.
VITE_SUPABASE_ANON_KEY=

# MISTRAL - server-only settings; never add a VITE_ prefix to the API key.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_SEARCH_MODEL=mistral-medium-latest

# Exact app origins allowed to call the Edge Functions, comma-separated.
# Add your production HTTPS origin before deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite exposes only VITE_ variables to the browser. MISTRAL_API_KEY stays private.
# Upload server configuration with: supabase secrets set --env-file .env.local
# Hosted functions receive SUPABASE_URL and SUPABASE_ANON_KEY automatically.
# Microsoft/Google/Apple provider secrets belong in Supabase Authentication > Providers.
